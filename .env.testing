# Defaults for the test suite (php artisan test loads this file when APP_ENV=testing).
# Real environment variables (CI, docker exec -e ...) take precedence over these values.
# Never point DB_DATABASE at a database with real data - tests wipe it (see tests/TestCase.php).
APP_NAME="Employee Management System"
APP_ENV=testing
APP_KEY=base64:zNrvWTrSrLehA+52em9jnJiTIcdRa/ncVT7F2lMlxvo=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=testing
DB_USERNAME=root
DB_PASSWORD=
